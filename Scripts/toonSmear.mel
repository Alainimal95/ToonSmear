// toonSmear.mel (formerly called "smearTrail")
//
// version: 3.2.1
//
// Generates a cartoon-style "smear trail" mesh that follows animated
// transforms (joints, locators, rivets, etc.).
//
// USAGE
//   1. Select two or more animated transforms IN THE ORDER you want them
//      connected (pick order is respected; they do not need to share a
//      hierarchy).
//   2. Run the script, then enter a name and adjust the settings:
//        - Trail length (frames): how far back the trail reaches (min 3, so
//          the loft can always be degree 3).
//        - Suffixes (collapsed section): the suffix used on groups, curves,
//          the loft surface and the final geometry. A leading underscore is
//          optional; one is always added between the descriptor and suffix.
//      Settings are remembered between runs (optionVars named toonSmear_*).
//
// HOW IT WORKS
//   - One live degree-1 curve has each CV driven by the world position of
//     one selected transform (decomposeMatrix -> controlPoints).
//   - The live curve is snapshotted over the last few frames. The snapshot
//     curves come back oldest -> newest, so they can be lofted directly.
//   - An expression keeps the snapshot window tied to the current frame
//     (also needed so a smear created on a frame without motion still
//     updates when you scrub).
//   - The loft is converted to polygons. Everything is parented under
//     <name>_Smear_<groupSuffix>, which should stay at identity (don't move it).
//
// NAMING
//   Every node is named <name>_<descriptor>_<suffix>, e.g. with name "arm":
//     arm_Smear_grp          top group
//     arm_SmearLive_crv      live curve
//     arm_SmearTrail_grp     snapshot group
//     arm_SmearTrail1_crv    trail curves
//     arm_SmearLoft_srf      loft surface
//     arm_Smear_geo          final polygon geometry
//   Fixed names (no suffix field): arm_Snap, arm_Smear_exp, arm_SmearDM1...
//
// NOTES
//   - Written against Maya 2022 conventions, tested in Maya 2027.
//   - If the targets don't move during the trail window (current frame minus
//     trail length, up to the current frame) on the frame you run this, all
//     trail curves coincide and Maya reports tessellation errors. The script
//     warns about this, and the smear updates once you scrub to a frame with
//     motion.
//   - Snapshots evaluate the target at past times, so this works for
//     keyframed animation but not for sims that depend on prior state.


///////////////////////////////////////////////////////////////////////////

// Naming helpers
//    Global so both the dialog callbacks and the build procs can use them.

// toonSmear_cleanSuffix
//    Trims whitespace and leading underscores, so "_grp", "__grp" and "grp"
//    all become "grp" (the underscore is added back by toonSmear_name).

global proc string toonSmear_cleanSuffix (string $s)
{
    string $c = strip($s);

    string $lead = match("^_+", $c);
    if ($lead != "")
    {
        if (size($lead) >= size($c))
            $c = "";
        else
            $c = substring($c, size($lead) + 1, size($c));
    }
    return $c;
}

// toonSmear_name
//    <name>_<descriptor>_<suffix>. An empty suffix gives <name>_<descriptor>.

global proc string toonSmear_name (string $name, string $descriptor, string $suffix)
{
    string $s = toonSmear_cleanSuffix($suffix);
    string $out = ($name + "_" + $descriptor);

    if ($s != "")
        $out += ("_" + $s);

    return $out;
}

// toonSmear_suffix
//    Current suffix for a key ("Grp", "Crv", "Srf", "Geo"): the saved
//    optionVar if there is one, otherwise the default.

global proc string toonSmear_suffix (string $key)
{
    string $var = ("toonSmear_sfx" + $key);

    if (`optionVar -exists $var`)
        return `optionVar -query $var`;

    if ($key == "Grp") return "grp";
    if ($key == "Crv") return "crv";
    if ($key == "Srf") return "srf";
    if ($key == "Geo") return "geo";
    return "";
}


///////////////////////////////////////////////////////////////////////////

// Dialog
//    layoutDialog calls its UI proc and button scripts by name (as strings),
//    so the toonSmear_dialog* procs must be GLOBAL procs; local procs aren't
//    visible to them. The dialog hands its values back through optionVars,
//    which also remember the last-used settings between runs.
//
//    optionVars used:
//      toonSmear_name     (string)  name entered in the dialog
//      toonSmear_trail    (int)     trail length in frames
//      toonSmear_sfxGrp   (string)  group suffix
//      toonSmear_sfxCrv   (string)  curve suffix
//      toonSmear_sfxSrf   (string)  loft surface suffix
//      toonSmear_sfxGeo   (string)  polygon geometry suffix
//
//    $gToonSmear_form holds the dialog's top-level form so the suffix
//    section can resize it when expanded/collapsed. Each proc that uses a
//    global declares it with "global" inside its own body.

// toonSmear_dialogHeight
//    Dialog height with the suffix section collapsed / expanded. These are
//    estimates: tweak them here if the dialog looks cramped or loose. If the
//    dialog doesn't resize when the section is toggled, set the collapsed
//    value equal to the expanded one so nothing is ever clipped.

global proc int toonSmear_dialogHeight (int $collapsed)
{
    if ($collapsed)
        return 190;
    return 320;
}

global proc toonSmear_dialogResize (int $collapsed)
{
    global string $gToonSmear_form;

    if ($gToonSmear_form == "")
        return;

    catch(`formLayout -edit -height (toonSmear_dialogHeight($collapsed)) $gToonSmear_form`);
}

global proc toonSmear_dialogUI ()
{
    global string $gToonSmear_form;

    // Last-used values, or defaults
    int $trail = 4;
    if (`optionVar -exists "toonSmear_trail"`)
        $trail = `optionVar -query "toonSmear_trail"`;

    // Suffix keys and the labels shown for them
    string $keys[]   = {"Grp", "Crv", "Srf", "Geo"};
    string $labels[] = {"Group", "Curve", "Surface", "Geometry"};
    int $i;

    // layoutDialog dimensions (starts with the suffix section collapsed)
    string $form = `setParent -query`;
    $gToonSmear_form = $form;
    formLayout -edit -width 328 -height (toonSmear_dialogHeight(1)) $form;

    // --- Settings (top) ---------------------------------------------------
    string $col = `columnLayout -adjustableColumn true -rowSpacing 6`;

        // Smear name
        textFieldGrp -label "Name" -text "smear"
                     -columnWidth2 150 150
                     toonSmear_nameField;

        // Trail length
        intSliderGrp -label "Trail length (frames)" -field true
                     -minValue 3 -maxValue 30
                     -fieldMinValue 3 -fieldMaxValue 60
                     -value $trail
                     -columnWidth3 150 40 110
                     toonSmear_trailField;

        separator -height 8 -style "none";

        // Suffixes (collapsible). A frameLayout may have only one child,
        // so the fields live in a column inside it.
        frameLayout -label "Suffixes" -collapsable true -collapse true
                    -marginWidth 4 -marginHeight 4
                    -collapseCommand "toonSmear_dialogResize 1"
                    -expandCommand   "toonSmear_dialogResize 0"
                    toonSmear_suffixFrame;

            columnLayout -adjustableColumn true -rowSpacing 4;

                for ($i = 0; $i < size($keys); $i++)
                {
                    textFieldGrp -label $labels[$i]
                                 -text (toonSmear_suffix($keys[$i]))
                                 -columnWidth2 150 150
                                 ("toonSmear_sfx" + $keys[$i] + "Field");
                }

            setParent ..;   // columnLayout -> frameLayout
        setParent ..;       // frameLayout  -> $col
    setParent ..;           // $col         -> $form

    // --- Buttons and messages (pinned to the bottom) ----------------------
    string $btnCol = `columnLayout -adjustableColumn true -rowSpacing 6`;

        rowLayout -numberOfColumns 2 -columnWidth2 150 150
                  -columnAttach2 "both" "both";
            button -label "OK" -command "toonSmear_dialogOk";
            button -label "Cancel" -command "layoutDialog -dismiss \"Cancel\"";
        setParent ..;

        // Shows validation messages without closing the dialog
        text -label " " -align "center" toonSmear_errorLabel;

    setParent ..;           // $btnCol -> $form

    formLayout -edit
        -attachForm $col    "top"    10
        -attachForm $col    "left"   10
        -attachForm $col    "right"  10
        -attachForm $btnCol "left"   10
        -attachForm $btnCol "right"  10
        -attachForm $btnCol "bottom" 10
        $form;
}

global proc toonSmear_dialogOk ()
{
    string $n = strip(`textFieldGrp -query -text toonSmear_nameField`);

    // Name must work in the eval string:
    // only letters, digits and underscores, and must start with a letter.
    if ($n == "" || !isValidObjectName($n))
    {
        text -edit -label "Name must start with a letter; letters, numbers and _ only."
             toonSmear_errorLabel;
        return;
    }

    // Read and validate the suffixes
    string $keys[] = {"Grp", "Crv", "Srf", "Geo"};
    string $sfx[];
    int $i;

    for ($i = 0; $i < size($keys); $i++)
    {
        $sfx[$i] = toonSmear_cleanSuffix(
            `textFieldGrp -query -text ("toonSmear_sfx" + $keys[$i] + "Field")`);

        // Allowed: empty, or letters/digits/underscores. "a" is prepended
        // only so isValidObjectName doesn't reject a leading digit.
        if ($sfx[$i] != "" && !isValidObjectName("a" + $sfx[$i]))
        {
            frameLayout -edit -collapse false toonSmear_suffixFrame;
            toonSmear_dialogResize 0;
            text -edit -label "Suffixes may only contain letters, numbers and _."
                 toonSmear_errorLabel;
            return;
        }
    }

    // Group, geometry and the expression ("exp") share the "Smear" descriptor,
    // so their suffixes must all differ or the names would collide.
    if ($sfx[0] == $sfx[3] || $sfx[0] == "exp" || $sfx[3] == "exp")
    {
        frameLayout -edit -collapse false toonSmear_suffixFrame;
        toonSmear_dialogResize 0;
        text -edit -label "Group and Geometry suffixes must differ (and not be 'exp')."
             toonSmear_errorLabel;
        return;
    }

    if (`objExists (toonSmear_name($n, "Smear", $sfx[0]))`)
    {
        text -edit -label ("A smear named '" + $n + "' already exists.")
             toonSmear_errorLabel;
        return;
    }

    int $trail = `intSliderGrp -query -value toonSmear_trailField`;

    // Clamp in case a typed value got past the field limits
    $trail = max(3, min(60, $trail));

    optionVar -stringValue "toonSmear_name"  $n;
    optionVar -intValue    "toonSmear_trail" $trail;

    for ($i = 0; $i < size($keys); $i++)
        optionVar -stringValue ("toonSmear_sfx" + $keys[$i]) $sfx[$i];

    layoutDialog -dismiss "OK";
}


///////////////////////////////////////////////////////////////////////////

// getUI
//    Shows the settings dialog. Returns the smear name, or "" if cancelled.
//    The settings themselves are read from the optionVars by smearBuild.

proc string getUI ()
{
    string $result = `layoutDialog -title "Smear Trail" -uiScript "toonSmear_dialogUI"`;

    if ($result != "OK")
        return "";

    return `optionVar -query "toonSmear_name"`;
}


///////////////////////////////////////////////////////////////////////////

// buildLiveCurve
//    One degree-1 curve whose CVs track the world position of each
//    transform in $sel. Returns the curve transform.

proc string buildLiveCurve (string $sel[], string $name)
{
    int $n = size($sel);
    int $i;

    // matrixNodes ships with Maya; this guard is harmless if already loaded
    if (catch(`loadPlugin -quiet "matrixNodes"`))
        warning "Could not load matrixNodes; decomposeMatrix may be unavailable.";

    string $crvName = toonSmear_name($name, "SmearLive", toonSmear_suffix("Crv"));

    // Placeholder points (CVs get driven below)
    string $cmd = ("curve -d 1 -n \"" + $crvName + "\"");
    for ($i = 0; $i < $n; $i++)
        $cmd += (" -p " + $i + " 0 0");
    string $crv = eval($cmd);

    string $shapes[] = `listRelatives -shapes -path $crv`;

    // Keep CV values == world space
    setAttr ($crv + ".inheritsTransform") 0;

    // Break out each target's world pos from its matrix (using decomposeMatrix) and
    // connect it to its corresponding CV's world pos
    for ($i = 0; $i < $n; $i++)
    {
        string $dm = `createNode decomposeMatrix -n (toonSmear_name($name, ("SmearDM" + ($i + 1)), ""))`;
        connectAttr -force ($sel[$i] + ".worldMatrix[0]") ($dm + ".inputMatrix");
        connectAttr -force ($dm + ".outputTranslate")
                           ($shapes[0] + ".controlPoints[" + $i + "]");
    }

    return $crv;
}


///////////////////////////////////////////////////////////////////////////

// snapshotLive
//    Creates animation snapshots of the live curve over [frame - $trail, frame],
//    keeps the window tied to the current frame with an expression, and renames the results.
//    Returns the trail curves, oldest -> newest.
//    $outGrp[0] receives the snapshot group name.

proc string[] snapshotLive (string $crv, string $name, int $trail, string $outGrp[])
{
    float $frame = `currentTime -query`;

    // Returns: [0] = snapshot group, [1] = snapshot node
    string $snap[] = `snapshot -n (toonSmear_name($name, "Snap", ""))
                               -ch on
                               -startTime ($frame - $trail)
                               -endTime $frame
                               -increment 1
                               $crv`;

    string $snapNode = $snap[1];

    expression -n (toonSmear_name($name, "Smear", "exp")) -s (
        $snapNode + ".startTime = frame - " + $trail + ";\n" +
        $snapNode + ".endTime = frame;\n" +
        $snapNode + ".increment = 1;\n"
        );

    string $trailCrvs[] = `listRelatives -children -path $snap[0]`;

    // Rename right away
    int $i;
    string $crvSuffix = toonSmear_suffix("Crv");
    for ($i = 0; $i < size($trailCrvs); $i++)
        $trailCrvs[$i] = `rename $trailCrvs[$i]
                                 (toonSmear_name($name, ("SmearTrail" + ($i + 1)), $crvSuffix))`;

    $outGrp[0] = `rename $snap[0] (toonSmear_name($name, "SmearTrail", toonSmear_suffix("Grp")))`;

    return $trailCrvs;
}


///////////////////////////////////////////////////////////////////////////

// trailHasMotion
//    Returns 1 if any trail curve differs from the first by more than $tol
//    (scene units) at any CV, otherwise 0. Trail curves sit under an
//    identity group, so their world-space CVs are the real trail positions.

proc int trailHasMotion (string $trailCrvs[], float $tol)
{
    float $ref[] = `xform -query -worldSpace -translation ($trailCrvs[0] + ".cv[*]")`;

    int $c, $k;
    for ($c = 1; $c < size($trailCrvs); $c++)
    {
        float $pos[] = `xform -query -worldSpace -translation ($trailCrvs[$c] + ".cv[*]")`;
        for ($k = 0; $k < size($ref); $k++)
        {
            if (abs($pos[$k] - $ref[$k]) > $tol)
                return 1;
        }
    }
    return 0;
}


///////////////////////////////////////////////////////////////////////////

// loftSmear
//    Lofts the trail curves and converts the surface to polygons.
//    Returns { loft surface transform, poly geo transform }.

proc string[] loftSmear (string $trailCrvs[], string $name)
{
    // Loft degree can't exceed (sections - 1)
    int $deg = min(3, size($trailCrvs) - 1);

    string $loft[] = `loft -n (toonSmear_name($name, "SmearLoft", toonSmear_suffix("Srf")))
                           -ch on
                           -ss 2
                           -d $deg
                           $trailCrvs`;

    // history, quads, general format, u/v number 2/5.
    // Without -ut/-vt set, these counts rely on the command's default
    // tessellation types; if the mesh density looks off, check those flags.
    string $geo[] = `nurbsToPoly -n (toonSmear_name($name, "Smear", toonSmear_suffix("Geo")))
                                 -ch on
                                 -pt 1
                                 -f 2
                                 -un 2
                                 -vn 5
                                 $loft[0]`;

    string $result[] = { $loft[0], $geo[0] };
    return $result;
}

///////////////////////////////////////////////////////////////////////////

// smearBuild
//    Does the work. Returns the top-level group name.

proc string smearBuild (string $sel[], string $name)
{
    // --- Settings (chosen in the dialog, stored in optionVars) ------------
    int $trail = `optionVar -query "toonSmear_trail"`;   // frames of trail
    // ----------------------------------------------------------------------

    string $crv = buildLiveCurve($sel, $name);

    string $snapGrp[];
    string $trailCrvs[] = snapshotLive($crv, $name, $trail, $snapGrp);

    // Warn if the targets don't move during the trail window. Maya's own
    // errors in that case (degenerate loft/tessellation) don't say why.
    // The status bar only shows the latest message, so the tessellation
    // errors would bury a plain warning. Also show it in the viewport.
    if (!trailHasMotion($trailCrvs, 0.0001))
    {
        float $f = `currentTime -query`;
        string $msg = ("No motion detected between frames " + ($f - $trail) + " and " + $f +
                       ". The trail curves coincide, so tessellation errors are expected. " +
                       "The smear will update once you move to a frame with motion.");

        // Script Editor log
        warning $msg;

        // Viewport message (catch in case there's no UI, e.g. batch mode)
        catch(`inViewMessage -assistMessage ("<hl>Smear:</hl> " + $msg)
                             -position midCenterTop
                             -fade
                             -fadeStayTime 6000`);
    }

    string $made[] = loftSmear($trailCrvs, $name);

    // Tidy: everything under one group, intermediates hidden
    string $grp = `group -empty -n (toonSmear_name($name, "Smear", toonSmear_suffix("Grp")))`;
    parent $crv $snapGrp[0] $made[0] $made[1] $grp;

    hide $crv;
    hide $snapGrp[0];
    hide $made[0];

    return $grp;
}

///////////////////////////////////////////////////////////////////////////

// toonSmear
//    Entry point: validate selection, show settings, build inside one undo chunk.

proc toonSmear ()
{
    // Pick order is respected; long names avoid duplicate-name ambiguity
    string $sel[] = `ls -sl -long`;

    if (size($sel) < 2)
        error "Must select at least 2 transforms to generate smear";

    // This may change when geo selection is added later
    string $each;
    for ($each in $sel)
    {
        if (!`objectType -isAType "transform" $each`)
            error ("Selection must be transforms only (not components): " + $each);
    }

    string $name = getUI();
    if ($name == "")
        return;

    // Also checked in the dialog; kept as a safety net
    if (`objExists (toonSmear_name($name, "Smear", toonSmear_suffix("Grp")))`)
        error ("A smear named '" + $name + "' already exists. Choose another name.");

    undoInfo -openChunk;
    int $failed = catch(`smearBuild $sel $name`);
    undoInfo -closeChunk;

    // Restore the user's selection
    select -r $sel;

    if ($failed)
        error "Smear creation failed; see Script Editor for details.";

    print ("Smear '" + $name + "' created from " + size($sel) + " transforms.\n");
}

///////////////////////////////////////////////////////////////////////////

toonSmear;
