//getUI
//User input
proc string getUI ()
    {
    //get name from user prompt
    string $name[];
    $name[0] = `promptDialog -tx "Name of smear"
                             -st "text"
                             -m ("Note: If target is static,\n" +
                                 "tesselation errors may appear\n" +
                                 "in the command line even if\n" +
                                 "operation is successful.\n")`;
                             
    $name[1] = `promptDialog -query -text`;
    
    //return
    return $name[1];
    };
    
///////////////////////////////////////////////////////

//getPos
    //Usage: Gets world space position of objects in an array
    //       then adds them to a string array to be assembled in a command
proc string[] getPos (string $bone[])
    {
    //variables:
        //point list
                string $cv[];
        //new point
                float $newPoint[];
        //cv list position
                int $i = 0;
    
    //get translate info for joints on both ends of each bone        
    for ($each in $bone)
        {
        //save position of active item in list
        $newPoint =  `xform -q -ws -t $each`;
    
        //copy position to cv list
        $cv[$i] = "-ep";
        $cv[( $i+1 )] = $newPoint[0];
        $cv[( $i+2 )] = $newPoint[1];
        $cv[( $i+3 )] = $newPoint[2];
        $i += 4;
        }
                
    //return result
    return $cv;
    
    };
    
/////////////////////////////////////////////////////////////////////////

//buildCurves
    //Usage: Builds lead "bone curves" overtop of
    //       selected items (presumably joints)
    //       then makes duplicates for lofting.
    //       Assumes "joints" are selected from
    //       root to tip.
proc string[] buildCurves (string $sel[], string $name)
    {
    //Setup variables for:
        //Point list
                string $cv[];
        //Pair of selected joints (bone)
                string $bone[];
        //How many bones are needed?
             //   int $chain = (`size $sel` - 1);
        //Curve command
                string $cmd;
        //Curve lists
                string $leadBones[];
                string $newBone[];
                string $smearBones[];
                                                        
    //Build a curve for each bone
    for ($b=1; `size $sel` > $b; $b++)
        {    
        //Place pairs of adjacent selected items into bone array
        $bone[0] = $sel[ ($b-1) ];
        $bone[1] = $sel[$b];
            
        //Get translate info for both ends of each bone
        $cv = `getPos $bone`;
        
        //Create curve at saved points
            //Reset command variable
            $cmd = ("curve -d 2 " +
                   ("-n (\"" + $name + "\" + \"SmearLead\"") +
                   " + \"" + $b + "_crv\") ");

            //Add points to command
            for ($all in $cv)
                $cmd += ($all + " "); 
            
            //Execute command
            $leadBones[ ($b-1) ] = `eval $cmd`;
            
        //Parent the lead curves to joints
        parent $leadBones[ ($b-1) ] $sel[ ($b-1) ];
            
        //Add duplicate leads as smear curves
        //    Note: errors seem to occur without the duplicates.
        //    Look into this later.
        $newBone = `duplicate -n ($name + "SmearBone" + $b + "_crv")
                               $leadBones[ ($b-1) ]`;
        
        $smearBones[ ($b-1) ] = $newBone[0];
        }
    
    //Condense returns
    string $return[] = stringArrayCatenate ($leadBones, $smearBones);
    
    //Return
    return $return;
    
    };

/////////////////////////////////////////////////////////////////////////

//snapshotLeads
//Usage: Create animation snapshots of selected lead curves
//       and create an expression to space them out
proc string[] snapshotLeads (string $leadCurves[], string $name, int $count)
    {
    //setup variables
    int $frame = `currentTime -query`;
    string $snapshot[];
    string $snapName;
    int $i = 1;
    string $newBones[];
    string $snapBones[];
    string $expression;
    
    for ($each in $leadCurves)
        {
        //Snapshot name
        $snapName = ($name + "Smear" + $i);
       
        //Create snapshot, construction history on
                         //Start frame -4 end frame -1 increment 1
        $snapshot = `snapshot -n $snapName
                              -ch on
                              -st ($frame-4)
                              -et ($frame-1)
                              -i 1
                              $each`;
               
        //Select and return the snapshot curves
        //    Note: They will be appended to the smearCurve list
        //          in the master script
            //Capture list of contents of the snapshot group
            $newBones = `listRelatives $snapshot[0]`;
            $snapBones = stringArrayCatenate ($snapBones, $newBones);
            
        //edit expression string
        $expression +=  ($snapName + ".startTime = (frame-4);\n" +
                         $snapName + ".endTime = (frame-1);\n" +
                         $snapName + ".increment = 1;\n" +
                         "\n");
            
        //Increment name
        $i++;
        }
        
    //Create expresssion   
    expression -n $name -s $expression; 
            
    //return result
    return $snapBones;
    };
    
/////////////////////////////////////////////////////////////////////////////////

//loftCurves
//    Usage: Attach snapshot curve bones then create a lofted surface from 
//           them. Then convert the surface to polygons.

proc loftCurves (string $smearBones[], int $crvCount, int $boneCount, string $name)
    {
    //Variables
    string $crvSegments[];
    string $smearCurves[];
    string $newCurve[];
    string $lead[];
    appendStringArray ($lead, $smearBones, $boneCount);
    
    //Make the lead curves
    $newCurve = `attachCurve -n ($name + "SmearCurve" + $crvCount + "_crv")
                                 -ch on  
                                 -m 1
                                 -rpo yes
                                 -kmk off
                                 $lead`;
                                 
    $smearCurves[0] = $newCurve[0];
                                 
    //To make each additional curve, use bones in the same 
    //    position in each snapshot group:
    //    Each curve needs ($boneCount) bones, 
	//	  There are ($boneCount) snapshot groups,
    //    Each snapshot group has ($crvCount) curves, 
	//    To select ($sel) the same bone in the next group,
	//    FOR EACH CURVE: multiply selection by total crvs (minus lead), 
    //    then add index-1 and $boneCount for curves already made
    //
    //A little janky, fix this later
    for ($c = 1; $c < $crvCount; $c++)
        {
        //Capture Segments from smearBones
        for ($sel = 0; $sel < $boneCount; $sel++)
            {
            $crvSegments[$sel] = 
				$smearBones[( ($sel*($crvCount-1))+($c-1)+$boneCount )];
			}
         
        //Merge snapshot bones
        $newCurve = `attachCurve -n ($name + "SmearCurve" + $c + "_crv")
                                 -ch on  
                                 -m 1
                                 -rpo yes
                                 -kmk off
                                 $crvSegments`;
       
        $smearCurves[$c] = $newCurve[0];
        }
    //Switch order of curves
    string $aux = $smearCurves[0];
    $smearCurves[($crvCount)] = $aux;
    stringArrayRemoveAtIndex (0, $smearCurves);
         
    //Loft surface with the Smear curves 
    //    history on, section spans 2
    string $loft[] = `loft -n ($name + "SmearLoft")
                           -ch on
                           -ss 2
						   -d 3
                           $smearCurves`;

    //Convert the surface to polygons with:
    //    history, quads, general format, u/v number 2/5
    string $smearGeo[] = `nurbsToPoly -n ($name + "Smear_geo")
                                      -ch on
                                      -pt 1
                                      -f 2
                                      -un 2
                                      -vn 5
                                      $loft[0]`;

    //Hide smear bones, loft surface, and smear curves
    hide $smearBones;
	hide $loft;
    hide $smearCurves;
    };
    
/////////////////////////////////////////////////////////////////////////

//smearTrail
//Usage: Build and rig smear curves from
//		 joints (or other transforms)
//		 selected from root to tip,
proc smearTrail ()
    {
    //Save selection
    string $sel[] = `ls -sl`;
        
        //Minimum selection
        if (2 > `size $sel`)
            error "Must select 2 transforms to generate smear";
        
    //get name of smear
    string $name = `getUI`;
    
    //Build Curves on joints
    string $bones[] = `buildCurves $sel $name`;
    hide $bones;
	
    //bone count
    int $boneCount = (`size $bones` / 2);
    
     //For fk's sake don't forget that appendStringArray
    //    doesn't work when executed on its own array
    string $leadBones[];
    appendStringArray ($leadBones, $bones, $boneCount);
                  
    string $smearBones[] = stringArrayRemove
                          ($leadBones, $bones);
    
    //Snapshot lead Bones
    string $snapBones[] = `snapshotLeads $leadBones $name $boneCount`;
    
    //Add snapBones to smearBones
    $smearBones = stringArrayCatenate ($smearBones, $snapBones);
    stringArrayRemoveDuplicates ($smearBones);
    
    //Total number of smear curves
    //(all snapshot bones/#bones per curve) + duplicate leads
    int $crvCount = ((`size $snapBones`/$boneCount)+1);
    
    //create surface from snapshot
    string $smearCurves[] = `loftCurves $smearBones $crvCount $boneCount $name`;
    
    //Rename items in:
        //snapBones
        string $newName;
    
        for ($each in $snapBones)
            {
            $newName = ((`substitute "transform" $each "smearTrail"`) + "_crv");            
            rename $each $newName;
            }
    };
    
/////////////////////////////////////////////////////////////////

smearTrail;